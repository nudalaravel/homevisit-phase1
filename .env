# Environment Configuration
BUILD_VERSION=2.9.0 - Build 1000

# ==========================================
# Environment Mode
# ==========================================
# production | development
NODE_ENV=production

# ==========================================
# Frontend Server (Nuxt Development)
# ==========================================
PORT=3300
HOST=0.0.0.0

# ==========================================
# API Configuration
# ==========================================
# Production API URL (used after build)
API_BASE_URL=https://ripedresearch.org
BROWSER_BASE_URL=https://ripedresearch.org



# API Endpoints
LOGIN_ENDPOINT=/api/spa/login/login.php
VERIFY_ENDPOINT=/api/spa/login/verify.php

# ==========================================
# Router Configuration
# ==========================================
# Base path for router (use / for root, /homevisit/ for subfolder)
ROUTER_BASE=/homevisit/

# ==========================================
# Auth Configuration
# ==========================================
# Token max age in seconds (1 year = 31536000)
AUTH_TOKEN_MAX_AGE=31536000

# ==========================================
# PWA Configuration
# ==========================================
# Enable/Disable Service Worker and Cache
# Set to 'true' to enable PWA caching, 'false' to disable
ENABLE_CACHE=true


# ==========================================
# App Configuration
# ==========================================
APP_NAME=Riped V2 Research
APP_SHORT_NAME=Riped Research
APP_TITLE=Riped V2 Research
APP_VERSION=1.0.0
APP_DESCRIPTION=Research Dashboard Template
APP_AUTHOR=Riped Team
APP_LANG=th

# ==========================================
# PWA Theme Configuration
# ==========================================
PWA_THEME_COLOR=#3551a4
PWA_BACKGROUND_COLOR=#ffffff
PWA_DISPLAY=standalone
PWA_ORIENTATION=portrait

# ==========================================
# PWA Icons & Assets
# ==========================================
PWA_ICON=/homevisit/logo.png
PWA_FAVICON=/homevisit/favicon.ico
PWA_MANIFEST=/homevisit/manifest.json

# ==========================================
# Proxy Configuration
# ==========================================
# Proxy target for development (bypass CORS)
PROXY_TARGET=https://ripedresearch.org
PROXY_CHANGE_ORIGIN=false
PROXY_SECURE=false
