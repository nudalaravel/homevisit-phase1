{
  "name": "riper-v2-admin",
  "version": "1.0.0",
  "description": "Nuxt.js 2 Admin Template with Mock APIs",
  "private": true,
  "scripts": {
    "dev": "nuxt",
    "dev:cache": "ENABLE_CACHE=true nuxt",
    "api": "node api/index.js",
    "dev:all": "concurrently \"npm run api\" \"npm run dev\" --names \"API,NUXT\" --prefix-colors \"blue,green\"",
    "build": "nuxt build",
    "build:cache": "ENABLE_CACHE=true nuxt build",
    "start": "nuxt start",
    "generate": "nuxt generate",
    "generate:cache": "ENABLE_CACHE=true nuxt generate"
  },
  "dependencies": {
    "@nuxtjs/auth": "^4.9.1",
    "@nuxtjs/axios": "^5.13.6",
    "@nuxtjs/bootstrap-vue": "^2.0.0",
    "@nuxtjs/pwa": "^3.3.5",
    "bootstrap": "^4.6.2",
    "bootstrap-vue": "^2.23.1",
    "chart.js": "^2.9.4",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "lodash": "^4.17.21",
    "nuxt": "^2.17.3",
    "vue-chartjs": "^3.5.1",
    "workbox-webpack-plugin": "^6.5.4"
  },
  "devDependencies": {
    "@nuxtjs/eslint-config": "^6.0.1",
    "eslint": "^7.32.0"
  }
}
